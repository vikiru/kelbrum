{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/frontend/tsconfig.json"],
  "entry": [
    "src/frontend/src/router.tsx",
    "src/frontend/src/routes/**",
    "src/frontend/*.config.ts"
  ],
  "ignoreDependencies": [
    "@semantic-release/git",
    "@semantic-release/npm",
    "semantic-release"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"]
}
