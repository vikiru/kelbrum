{
  "name": "kelbrum",
  "version": "1.0.0",
  "private": true,
  "description": "An anime recommendation system designed to recommend anime that is similar to user-selected anime.",
  "keywords": [
    "anime",
    "recommendation",
    "system",
    "machine-learning",
    "tensorflow",
    "kelbrum",
    "similarity",
    "kmeans",
    "react",
    "react router",
    "tailwindcss",
    "daisyui"
  ],
  "bugs": {
    "url": "https://github.com/vikiru/kelbrum/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vikiru/kelbrum"
  },
  "license": "MIT",
  "author": "Visakan Kirubakaran",
  "type": "module",
  "scripts": {
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "format": "biome check --write",
    "lint": "biome lint",
    "prepare": "husky",
    "start": "react-scripts start",
    "test": "react-scripts test",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "development": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ],
    "production": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-private-property-in-object": "^7.23.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^10.8.1",
    "lemmatizer": "^0.0.1",
    "lodash": "^4.17.21",
    "minisearch": "^6.3.0",
    "ml-distance": "^4.0.1",
    "natural": "^6.10.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-infinite-scroller": "^1.2.6",
    "react-router-dom": "^6.22.2",
    "react-scripts": "5.0.1",
    "react-slick": "^0.30.2",
    "remove-stopwords": "^1.0.3",
    "slick-carousel": "^1.8.1",
    "web-vitals": "^3.5.2",
    "word-list": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tensorflow/tfjs": "^4.17.0",
    "@types/lint-staged": "~13.3.0",
    "@types/lodash": "~4.17.20",
    "@types/node": "^20.11.17",
    "@types/papaparse": "~5.3.16",
    "@types/postcss-import": "~14.0.3",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@types/react-infinite-scroller": "~1.2.5",
    "@types/react-slick": "~0.23.13",
    "@types/slick-carousel": "~1.6.40",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.5.5",
    "daisyui": "^4.7.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "ml-kmeans": "^6.0.0",
    "papaparse": "^5.4.1",
    "postcss": "^8.4.35",
    "postcss-import": "^16.0.1",
    "semantic-release": "^24.2.6",
    "simple-statistics": "^7.8.3",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=16.9"
  }
}
