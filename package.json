{
  "name": "kelbrum",
  "description": "An anime recommendation system designed to recommend anime that is similar to user-selected anime.",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Visakan Kirubakaran",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikiru/kelbrum"
  },
  "bugs": {
    "url": "https://github.com/vikiru/kelbrum/issues"
  },
  "keywords": [
    "anime",
    "daisyui",
    "kelbrum",
    "kmeans",
    "machine-learning",
    "react",
    "react router",
    "recommendation",
    "similarity",
    "system",
    "tailwindcss",
    "tensorflow"
  ],
  "browserslist": {
    "production": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ],
    "development": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ]
  },
  "scripts": {
    "start": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "preview": "pnpm --dir frontend preview",
    "lint": "pnpm --dir frontend lint",
    "lint:typecheck": "pnpm --dir frontend lint:typecheck",
    "format": "oxfmt --write",
    "format:check": "pnpm --dir frontend format:check",
    "typecheck": "pnpm --dir frontend typecheck",
    "unused": "knip",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "knip": "^5.88.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.81.0",
    "oxlint-tailwindcss": "^1.10.2",
    "oxlint-tsgolint": "^7.0.2001",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=16.9"
  }
}
