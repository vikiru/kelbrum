{
    "hosting": {
        "headers": [
            {
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ],
                "source": "/**"
            }
        ],
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "public": "build",
        "rewrites": [
            {
                "destination": "/index.html",
                "source": "**"
            }
        ]
    }
}
